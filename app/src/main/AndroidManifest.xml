<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      v0.3.0: the permission-free baseline (v0.2) deliberately stays, but
      two OPT-IN features add permissions of their own:

      * Floating assistant (off by default): SYSTEM_ALERT_WINDOW for the
        overlay bubble (granted in Android settings, never at runtime) and
        a FOREGROUND_SERVICE (specialUse) so the bubble survives while
        other apps are in front. POST_NOTIFICATIONS is required to show
        the assistant's foreground-service notification on API 33+.
      * Fingerprint unlock (off by default): USE_BIOMETRIC for the system
        BiometricPrompt; the wrap key lives in the Android Keystore with
        setUserAuthenticationRequired(true).

      With both features disabled (the default), the app behaves exactly
      like v0.2: no permission is requested, no service runs, and there is
      no network code.

      v0.5.1 largeHeap: the opt-in PARANOID Argon2id profile (256 MiB) needs
      one contiguous 256 MiB array; a stock heap caps at 128-256 MB. The
      pre-flight guard in Argon2KeyDerivator still rejects the profile with
      an honest notice when even the large heap cannot serve it — this flag
      only lets capable devices actually run it.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".TurnyptApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Turnypt">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              v0.5.0: static launcher shortcuts — long-press the app icon
              for "Encrypt clipboard" / "Decrypt clipboard", the universal
              fallback for messengers whose selection menu hosts no
              third-party entries (Telegram, WhatsApp message bubbles).
              See docs/COMPATIBILITY.md. Zero permissions.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          Companion entries (Option E). Labels are user-visible in the
          system selection toolbar and sharesheet; keep them short.
          noHistory + excludeFromRecents: utility flows, nothing kept in
          recents; an abandoned flow is discarded (passphrase included).

          v1.0.0 taskAffinity="" (user report: "tapping Encrypt in the
          floating assistant closes my app and switches to the full app"):
          a companion launched with FLAG_ACTIVITY_NEW_TASK resolves to any
          task carrying the app's default affinity — i.e. the EXISTING main
          task — so Android dragged the whole app (main screen behind the
          translucent sheet) in front of the messenger. With an EMPTY
          affinity the sheet always gets its own featherweight task stacked
          on top of whatever the user is doing: the messenger stays visible
          behind the dimmed sheet, and finish() lands the user exactly where
          they were. Same discipline for every companion surface (overlay,
          sharesheet, PROCESS_TEXT, shortcuts) — the flows never own a
          back stack of the main app.
        -->

        <activity
            android:name=".companion.EncryptActivity"
            android:exported="true"
            android:label="@string/process_text_encrypt_label"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Turnypt.Companion">
            <intent-filter android:label="@string/process_text_encrypt_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".companion.DecryptActivity"
            android:exported="true"
            android:label="@string/process_text_decrypt_label"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Turnypt.Companion">
            <intent-filter android:label="@string/process_text_decrypt_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".companion.ShareDecryptActivity"
            android:exported="true"
            android:label="@string/share_decrypt_label"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Turnypt.Companion">
            <intent-filter android:label="@string/share_decrypt_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          v0.5.0: no-display trampoline for the static launcher shortcuts.
          Static shortcut intents cannot carry extras; the shortcuts target
          this activity with dedicated actions and it forwards into the
          existing clipboard companion flows (EXTRA_FROM_CLIPBOARD).
          Same noHistory/excludeFromRecents discipline as its targets.
        -->
        <activity
            android:name=".companion.ClipboardShortcutActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="com.turnypt.app.action.ENCRYPT_CLIPBOARD" />
                <action android:name="com.turnypt.app.action.DECRYPT_CLIPBOARD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          v0.6.0 image companion (docs/IMAGE-CRYPTO.md): sharesheet and
          file-entry into the SAME image flows the in-app tabs host.
          SEND image/* encrypts the shared image; SEND/VIEW of a .cki file
          (typed or untyped) decrypts it. FLAG_SECURE is set in code;
          noHistory/excludeFromRecents/taskAffinity follow the companion
          discipline (an abandoned flow is discarded, passphrase included).


          v1.0.0 .cki OPEN-WITH FIX (user report: "tapping a .cki file
          suggests nothing, and this app is the only one that can read
          it"). File managers cannot know our custom MIME type — for an
          unregistered extension like .cki they resolve the MIME to
          application/octet-stream (or send no type at all), so the
          v0.6.0 filter on application/x-cipherkey alone NEVER matched.
          The fix is extension matching via pathPattern (the AOSP
          PatternMatcher simple-glob: ".*" spans any sequence, "\\.cki" is
          a literal dot + extension), declared in the four shapes real
          file managers produce:
            - content:// with a MIME type (octet-stream from MediaStore,
              our own x-cipherkey, or a file manager's guess);
            - content:// with NO type at all;
            - file:// with a MIME type (older/legacy explorers);
            - file:// with no type.
          Most providers embed the real file path in the URI (Files by
          Google, Solid Explorer, Samsung My Files), so the pattern has
          something to match; SEND (sharesheet) gets the same treatment
          so a .cki can be shared INTO the app, not only opened.
        -->
        <activity
            android:name=".companion.ImageCipherActivity"
            android:exported="true"
            android:label="@string/image_encrypt_label"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Turnypt.Companion">
            <intent-filter android:label="@string/image_encrypt_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="@string/image_decrypt_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-cipherkey" />
            </intent-filter>
            <!-- sharesheet: a .cki shared from a file manager -->
            <intent-filter android:label="@string/image_decrypt_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.cki" />
            </intent-filter>
            <!-- open with: content:// uri that carries a MIME type -->
            <intent-filter android:label="@string/image_decrypt_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/x-cipherkey" />
            </intent-filter>
            <intent-filter android:label="@string/image_decrypt_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.cki" />
            </intent-filter>
            <!-- open with: content:// uri with no MIME type at all -->
            <intent-filter android:label="@string/image_decrypt_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.cki" />
            </intent-filter>
            <!-- open with: legacy file:// uris, typed and untyped -->
            <intent-filter android:label="@string/image_decrypt_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.cki" />
            </intent-filter>
            <intent-filter android:label="@string/image_decrypt_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.cki" />
            </intent-filter>
        </activity>

        <!--
          v0.6.0: exposes ONLY the decrypted-image preview cache for the
          "Share image" affordance (see res/xml/file_paths.xml).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          v0.3.0 floating assistant: a user-enabled overlay bubble with
          quick Encrypt/Decrypt-clipboard actions. Started only from the
          Settings toggle (or the auto-start after the user enabled it);
          never exported, no intent filters.
        -->
        <service
            android:name=".assistant.FloatingAssistantService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled floating quick-access overlay for clipboard encryption and decryption actions" />
        </service>
    </application>

</manifest>
