<?xml version="1.0" encoding="utf-8"?>
<!--
  Turnypt launcher icon, monochrome (themed icons, Android 13+).

  Same geometry as ic_launcher_foreground, flattened to a single-color
  silhouette: the leaves are SEPARATE paths (they paint over the bulb,
  so their hidden bases cause no even-odd holes) and the keyhole is
  knocked out of the bulb via fillType="evenOdd" (bulb outline + the
  single-path keyhole subpath). The launcher tints this layer to match
  the user's wallpaper color scheme.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.95"
        android:scaleY="0.95"
        android:translateY="2">

        <path
            android:fillColor="#FFFFFF"
            android:pathData="M51.5,40 Q48.9,29.5 39.2,26.8 Q41.9,36.6 51.5,40 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M56.5,40 Q59.1,29.5 68.8,26.8 Q66.1,36.6 56.5,40 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M54,39.5 C50,32.5 50,27 54,24.2 C58,27 58,32.5 54,39.5 Z" />

        <!-- bulb + keyhole cut-out in one even-odd path -->
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M44,38.5 C48,37.3 60,37.3 64,38.5 C71,41 76.5,47 78,53.5 C79.6,60.5 75,67.5 70,72.5 C65,77 59,79.3 54,79.6 C49,79.3 43,77 38,72.5 C33,67.5 28.4,60.5 30,53.5 C31.5,47 37,41 44,38.5 Z M47.1,60.5 A8,8 0 1,1 60.9,60.5 L63.5,72.5 L44.5,72.5 Z" />
    </group>
</vector>
