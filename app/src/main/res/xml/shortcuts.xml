<?xml version="1.0" encoding="utf-8"?>
<!--
  v0.5.0 launcher app shortcuts (docs/COMPATIBILITY.md, docs/DESIGN.md
  §4.2): long-press the Turnypt icon for "Encrypt clipboard" /
  "Decrypt clipboard" — the selection-toolbar fallback that works in
  every messenger, including Telegram (whose message-selection menu
  never hosts third-party PROCESS_TEXT entries).

  Static shortcut intents cannot carry extras, so both shortcuts target
  the no-display trampoline ClipboardShortcutActivity, which forwards
  into the existing audited clipboard companion flows.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="encrypt_clipboard"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_encrypt"
        android:shortcutShortLabel="@string/shortcut_encrypt_short"
        android:shortcutLongLabel="@string/shortcut_encrypt_long">
        <intent
            android:action="com.turnypt.app.action.ENCRYPT_CLIPBOARD"
            android:targetPackage="com.turnypt"
            android:targetClass="com.turnypt.app.companion.ClipboardShortcutActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="decrypt_clipboard"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_decrypt"
        android:shortcutShortLabel="@string/shortcut_decrypt_short"
        android:shortcutLongLabel="@string/shortcut_decrypt_long">
        <intent
            android:action="com.turnypt.app.action.DECRYPT_CLIPBOARD"
            android:targetPackage="com.turnypt"
            android:targetClass="com.turnypt.app.companion.ClipboardShortcutActivity" />
    </shortcut>
</shortcuts>
